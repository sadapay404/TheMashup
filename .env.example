# ── Express API gateway (apps/api) ─────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Internal URL of the Python resolver microservice
RESOLVER_URL=http://127.0.0.1:8000
# LRCLIB public lyrics API (keyless)
LYRICS_BASE=https://lrclib.net
# 1 = serve lyrics from fixtures instead of lrclib.net (offline / sandbox demos)
MOCK_UPSTREAM=0
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# ── Python resolver (services/resolver) ────────────────────────
RESOLVER_PORT=8000
RESOLVER_HOST=0.0.0.0
# 1 = fixtures + local mock audio tones instead of YouTube/Piped/Invidious
RESOLVER_MOCK=0
# Base URL the mock uses to advertise its own audio files (must be reachable by the gateway)
MOCK_PUBLIC_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT=8
# Fallback instance pools (comma separated). yt-dlp is primary; these are fallbacks only.
PIPED_INSTANCES=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de,https://api.piped.yt
INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://yewtu.be,https://invidious.nerdvpn.de

# ── Phase 4: auth + library (OPTIONAL — local demo mode works without) ──
# Gateway: service-role key stays SERVER-ONLY (never exposed to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 1 = allow local demo identities (auto-enabled when SUPABASE_URL is empty)
ALLOW_DEV_AUTH=1
# Where the local JSON library persists when Supabase isn't configured
LIBRARY_DB_PATH=data/library.json

# Web client (safe to expose: anon key is public by design)
# Vite reads these from this repo-root file (envDir = ".." in vite.config.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
