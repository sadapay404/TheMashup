<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for the media notification.

  Android requires a small icon that is a single-colour alpha mask: the system discards any colour
  and tints what remains. Without a dedicated one, Media3 either falls back to something invisible
  at 24dp or the notification simply fails to post, which is why the shade stayed empty.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3v10.55A4,4 0,1 0,14 17V7h4V3z" />
</vector>
