<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheMashup.UI"
             x:Class="TheMashup.UI.Views.MainView" x:DataType="vm:ShellViewModel"
             Background="{DynamicResource AppBackground}">
  <UserControl.Resources>
    <DataTemplate x:Key="SearchTrackTemplate" x:DataType="vm:SearchTrackRowViewModel">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
              BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Snippet}" IsVisible="{Binding HasSnippet}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="No matching catalog track yet" IsVisible="{Binding IsUnmatched}" Classes="subtle" FontSize="11" />
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Classes="secondary" Content="Lyrics" Command="{Binding LyricsCommand}" Margin="3,3"
                    AutomationProperties.Name="View song lyrics" />
            <Button Classes="secondary" Content="{Binding LikeText}" Command="{Binding LikeCommand}" IsEnabled="{Binding CanLike}" Margin="3,3"
                    AutomationProperties.Name="Like song" />
            <Button Classes="secondary" Content="Playlist" Command="{Binding PlaylistCommand}" IsEnabled="{Binding CanLike}" Margin="3,3"
                    AutomationProperties.Name="Add song to playlist" />
            <Button Classes="secondary" Content="Queue" Command="{Binding QueueCommand}" IsEnabled="{Binding IsMatched}" Margin="3,3"
                    AutomationProperties.Name="Add song to queue" />
          </WrapPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="SavedTrackTemplate" x:DataType="vm:SavedTrackRowViewModel">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
              BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,7">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Artist}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="Remove" Command="{Binding RemoveCommand}"
                  AutomationProperties.Name="Remove saved song" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding SidebarWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left navigation: it contracts on smaller windows. -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
              BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="84,*,Auto">
          <Grid Grid.Row="0" Margin="18,0" ColumnDefinitions="40,*" ColumnSpacing="11">
            <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource Accent}"
                    VerticalAlignment="Center">
              <TextBlock Text="m." Foreground="{DynamicResource AccentText}" FontSize="22" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,1,0" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding ShowNavLabels}">
              <TextBlock Text="TheMashup" FontWeight="Bold" FontSize="15" />
              <TextBlock Text="YOUR MUSIC SPACE" Classes="subtle" FontWeight="SemiBold" FontSize="9" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Margin="12,13,12,0" Spacing="4">
            <TextBlock Text="EXPLORE" Classes="eyebrow" Margin="12,0,0,8" IsVisible="{Binding ShowNavLabels}" />
            <Button Classes="nav" Classes.active="{Binding IsHome}" Command="{Binding NavigateCommand}"
                    CommandParameter="home" AutomationProperties.Name="Home" ToolTip.Tip="Home">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Viewbox Width="19" Height="19"><Path Data="{StaticResource HomeIcon}" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" /></Viewbox>
                <TextBlock Text="Home" IsVisible="{Binding ShowNavLabels}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsSearch}" Command="{Binding NavigateCommand}"
                    CommandParameter="search" AutomationProperties.Name="Search" ToolTip.Tip="Search">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Viewbox Width="19" Height="19"><Path Data="{StaticResource SearchIcon}" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" /></Viewbox>
                <TextBlock Text="Search" IsVisible="{Binding ShowNavLabels}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="YOUR MUSIC" Classes="eyebrow" Margin="12,25,0,8" IsVisible="{Binding ShowNavLabels}" />
            <Button Classes="nav" Classes.active="{Binding IsLibrary}" Command="{Binding NavigateCommand}"
                    CommandParameter="library" AutomationProperties.Name="Your library" ToolTip.Tip="Your library">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Viewbox Width="19" Height="19"><Path Data="{StaticResource LibraryIcon}" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" /></Viewbox>
                <TextBlock Text="Your library" IsVisible="{Binding ShowNavLabels}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsDownloads}" Command="{Binding NavigateCommand}"
                    CommandParameter="downloads" AutomationProperties.Name="Downloads" ToolTip.Tip="Downloads">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Viewbox Width="19" Height="19"><Path Data="{StaticResource DownloadIcon}" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" /></Viewbox>
                <TextBlock Text="Downloads" IsVisible="{Binding ShowNavLabels}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="12,0,12,18" Spacing="8">
            <Button Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding NavigateCommand}"
                    CommandParameter="settings" AutomationProperties.Name="Appearance" ToolTip.Tip="Appearance">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <Viewbox Width="19" Height="19"><Path Data="{StaticResource SettingsIcon}" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" /></Viewbox>
                <TextBlock Text="Appearance" IsVisible="{Binding ShowNavLabels}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

          </StackPanel>
        </Grid>
      </Border>

      <!-- Shared primary content area. -->
      <Grid Grid.Column="1" RowDefinitions="70,*" Background="{DynamicResource AppBackground}">
        <Border Grid.Row="0" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" Margin="30,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <TextBlock Text="YOUR SPACE" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Text="/" Classes="subtle" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PageTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Margin="30,24,30,34">
            <!-- Home: real empty states, not mock songs or recommendations. -->
            <StackPanel IsVisible="{Binding IsHome}" Spacing="22" MaxWidth="1050" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="MADE FOR YOUR MOMENTS" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Good to see you." FontSize="29" FontWeight="Bold" />
                  <TextBlock Text="A little more space for the music you love." Classes="muted" FontSize="13" />
                </StackPanel>

              </Grid>

              <Border Height="244" CornerRadius="18" Background="{DynamicResource HeroStart}" ClipToBounds="True">
                <Grid>
                  <Ellipse IsVisible="{Binding ShowHeroArtwork}" Width="278" Height="278" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,52,0"
                           Fill="{DynamicResource HeroEnd}" Opacity="0.72" />
                  <Ellipse IsVisible="{Binding ShowHeroArtwork}" Width="214" Height="214" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,84,0"
                           Stroke="{DynamicResource Accent}" StrokeThickness="1" Opacity="0.28" />
                  <Ellipse IsVisible="{Binding ShowHeroArtwork}" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,143,0"
                           Fill="{DynamicResource Accent}" Opacity="0.22" />
                  <StackPanel Margin="30,25" Spacing="9" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="405">
                    <TextBlock Text="A FRESH START" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Make it your own." FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="A calmer place for your songs, playlists, and everything you’ll discover next."
                               Classes="muted" TextWrapping="Wrap" FontSize="13" MaxWidth="330" HorizontalAlignment="Left" />
                    <Button Classes="action" Content="Explore appearance  →" Margin="0,8,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="settings"
                            HorizontalAlignment="Left" AutomationProperties.Name="Explore appearance" />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="Start here" FontSize="17" FontWeight="Bold" />
                  <TextBlock Text="The essentials, all in one place." Classes="muted" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="YOUR THEME" Classes="eyebrow" VerticalAlignment="Bottom" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                        BorderThickness="1" CornerRadius="14" Padding="18">
                  <StackPanel Spacing="10">
                    <Border Width="37" Height="37" CornerRadius="10" Background="{DynamicResource RaisedSurface}" HorizontalAlignment="Left">
                      <Viewbox Width="18" Height="18"><Path Data="{StaticResource LibraryIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" /></Viewbox>
                    </Border>
                    <TextBlock Text="Your library" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="{Binding PlaylistCountText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button Classes="secondary" Content="Open library  →" Command="{Binding NavigateCommand}" CommandParameter="library"
                            HorizontalAlignment="Left" AutomationProperties.Name="Open library" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                        BorderThickness="1" CornerRadius="14" Padding="18">
                  <StackPanel Spacing="10">
                    <Border Width="37" Height="37" CornerRadius="10" Background="{DynamicResource RaisedSurface}" HorizontalAlignment="Left">
                      <Viewbox Width="18" Height="18"><Path Data="{StaticResource SparkIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="1.7" /></Viewbox>
                    </Border>
                    <TextBlock Text="Make it feel like you" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentThemeName, StringFormat='Current theme: {0}'}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button Classes="secondary" Content="Change theme  →" Command="{Binding NavigateCommand}" CommandParameter="settings"
                            HorizontalAlignment="Left" AutomationProperties.Name="Change theme" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="Search is available in the development preview. Playback, recommendations, and downloads are still being built."
                         Classes="subtle" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Real local playlist operations. Songs arrive with the catalog/playback phases. -->
            <StackPanel IsVisible="{Binding IsLibrary}" Spacing="20" MaxWidth="1050" HorizontalAlignment="Stretch">
              <StackPanel Spacing="5">
                <TextBlock Text="YOUR COLLECTION" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Your library" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Playlists stay on this device, just for you." Classes="muted" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>

              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                      BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                  <TextBlock Text="Create a playlist" FontSize="16" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Text="{Binding NewPlaylistName, Mode=TwoWay}" Watermark="Playlist name"
                             MaxLength="80" IsEnabled="{Binding CanEditLibrary}"
                             AutomationProperties.Name="New playlist name" />
                    <Button Grid.Column="1" Classes="action" Content="Create" Command="{Binding CreatePlaylistCommand}"
                            IsEnabled="{Binding CanEditLibrary}" AutomationProperties.Name="Create playlist" />
                  </Grid>
                  <TextBlock Text="{Binding PlaylistMessage}" IsVisible="{Binding HasPlaylistMessage}"
                             Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding LibraryStatus}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Playlists" FontSize="18" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding PlaylistCountText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <Border IsVisible="{Binding HasNoPlaylists}" Background="{DynamicResource Surface}"
                      BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="5">
                  <TextBlock Text="Your first playlist starts here." FontWeight="SemiBold" />
                  <TextBlock Text="Create one above, then add songs from Search."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <!-- A bounded ListBox virtualizes rows instead of constructing a huge visual tree. -->
              <ListBox ItemsSource="{Binding PlaylistRows}" IsVisible="{Binding HasPlaylists}" MaxHeight="420"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Playlists">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlaylistRowViewModel">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel IsVisible="{Binding IsViewing}" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SongCountText}" Classes="muted" FontSize="11" />
                          </StackPanel>
                          <TextBox IsVisible="{Binding IsEditing}" Text="{Binding DraftName, Mode=TwoWay}"
                                   MaxLength="80" AutomationProperties.Name="Rename playlist" />
                          <TextBlock IsVisible="{Binding IsConfirmingDelete}" Text="Delete this playlist?"
                                     VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsViewing}">
                            <Button Classes="secondary" Content="Rename" Command="{Binding BeginRenameCommand}"
                                    AutomationProperties.Name="Rename playlist action" />
                            <Button Classes="secondary" Content="Delete" Command="{Binding BeginDeleteCommand}"
                                    AutomationProperties.Name="Delete playlist action" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                            <Button Classes="action" Content="Save" Command="{Binding SaveNameCommand}" AutomationProperties.Name="Save playlist name" />
                            <Button Classes="secondary" Content="Cancel" Command="{Binding CancelRenameCommand}" AutomationProperties.Name="Cancel playlist rename" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
                            <Button Classes="action" Content="Delete" Command="{Binding ConfirmDeleteCommand}" AutomationProperties.Name="Confirm playlist deletion" />
                            <Button Classes="secondary" Content="Cancel" Command="{Binding CancelDeleteCommand}" AutomationProperties.Name="Cancel playlist deletion" />
                          </StackPanel>
                        </Grid>
                        <Button Classes="secondary" Content="{Binding ToggleSongsText}" Command="{Binding ToggleSongsCommand}"
                                IsVisible="{Binding IsViewing}" HorizontalAlignment="Left" AutomationProperties.Name="View playlist songs" />
                        <TextBlock Text="No songs in this playlist yet." IsVisible="{Binding ShowEmptySongs}" Classes="subtle" FontSize="11" />
                        <ListBox ItemsSource="{Binding Songs}" IsVisible="{Binding IsExpanded}" ItemTemplate="{StaticResource SavedTrackTemplate}"
                                 MaxHeight="220" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Playlist songs">
                          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.Styles>
                        </ListBox>
                        <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                                   Foreground="{DynamicResource Accent}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Liked songs" FontSize="18" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding Search.LikedSummary}" Classes="muted" FontSize="12" />
              </Grid>
              <ListBox ItemsSource="{Binding Search.LikedTracks}" IsVisible="{Binding Search.HasLikedTracks}"
                       ItemTemplate="{StaticResource SavedTrackTemplate}" MaxHeight="280" Background="Transparent"
                       BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Liked songs">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.Styles>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Manual queue" FontSize="18" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding Search.QueueSummary}" Classes="muted" FontSize="12" />
              </Grid>
              <ListBox ItemsSource="{Binding Search.QueuedTracks}" IsVisible="{Binding Search.HasQueuedTracks}"
                       ItemTemplate="{StaticResource SavedTrackTemplate}" MaxHeight="280" Background="Transparent"
                       BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Queued songs">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.Styles>
              </ListBox>
              <TextBlock Text="Adding a song to the queue does not start playback. Listening history will appear after the player is connected."
                         Classes="subtle" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Actual search: independent catalog, suggestions, lyric search and lyric text. -->
            <StackPanel IsVisible="{Binding IsSearch}"
                        Spacing="16" MaxWidth="1050" HorizontalAlignment="Stretch">
              <StackPanel Spacing="5">
                <TextBlock Text="DISCOVER" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Find your music." FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Search songs, artists, albums or a line you remember." Classes="muted" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Search.Query, Mode=TwoWay}" Watermark="Song, artist, album or lyric" MaxLength="200"
                         KeyDown="OnSearchKeyDown" AutomationProperties.Name="Search music" />
                <Button Grid.Column="1" Classes="action" Content="Search" Command="{Binding Search.SubmitCommand}"
                        AutomationProperties.Name="Search music action" />
              </Grid>
              <TextBlock Text="{Binding Search.SuggestionStatus}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Search.Suggestions}" IsVisible="{Binding Search.HasSuggestions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchSuggestionViewModel">
                    <Button Classes="secondary" Content="{Binding Text}" Command="{Binding ChooseCommand}" Margin="0,0,7,7"
                            AutomationProperties.Name="Search suggestion" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Search.ActionStatus}" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" />
              <Border IsVisible="{Binding Search.ShowPlaylistPicker}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                      BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Search.PlaylistTrackTitle, StringFormat='Add to playlist: {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="secondary" Content="Close" Command="{Binding Search.ClosePlaylistCommand}" AutomationProperties.Name="Close playlist picker" />
                  </Grid>
                  <TextBlock Text="Create a playlist in Your library if you don't have one yet." Classes="subtle" FontSize="11" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding Search.PlaylistChoices}" SelectedItem="{Binding Search.SelectedPlaylist, Mode=TwoWay}"
                              IsEnabled="{Binding Search.HasPlaylistChoices}" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose playlist">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlaylistChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Classes="action" Content="Add" Command="{Binding Search.AddToPlaylistCommand}" IsEnabled="{Binding Search.CanAddToPlaylist}"
                            AutomationProperties.Name="Confirm add to playlist" />
                  </Grid>
                  <TextBlock Text="{Binding Search.PlaylistStatus}" Foreground="{DynamicResource Accent}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border IsVisible="{Binding Search.ShowLyrics}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                      BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Search.LyricsTitle}" FontWeight="Bold" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="secondary" Content="Close" Command="{Binding Search.CloseLyricsCommand}" AutomationProperties.Name="Close lyrics" />
                  </Grid>
                  <TextBlock Text="{Binding Search.LyricsStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Search.LyricsText}" FontSize="13" LineHeight="22" TextWrapping="Wrap" AutomationProperties.Name="Song lyrics" />
                  </ScrollViewer>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Search.CatalogStatus}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Search.ArtistsAndAlbums}" IsVisible="{Binding Search.HasArtistsAndAlbums}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchSuggestionViewModel">
                    <Button Classes="secondary" Content="{Binding Text}" Command="{Binding ChooseCommand}" Margin="0,0,7,7"
                            AutomationProperties.Name="Search artist or album" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox ItemsSource="{Binding Search.Tracks}" IsVisible="{Binding Search.HasTracks}" ItemTemplate="{StaticResource SearchTrackTemplate}"
                       MaxHeight="440" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Song search results">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.Styles>
              </ListBox>
              <TextBlock Text="{Binding Search.LyricSearchStatus}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding Search.LyricHits}" IsVisible="{Binding Search.HasLyricHits}" ItemTemplate="{StaticResource SearchTrackTemplate}"
                       MaxHeight="400" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Lyric search results">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.Styles>
              </ListBox>
              <TextBlock Text="Playback is not connected yet. Queue adds only the selected song; it does not start music."
                         Classes="subtle" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Honest, navigable states for the features that will be implemented later. -->
            <StackPanel IsVisible="{Binding IsFeaturePage}" Spacing="20" MaxWidth="1050" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding FeatureEyebrow}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10" />
              <TextBlock Text="{Binding PageTitle}" FontWeight="Bold" FontSize="29" />
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                      BorderThickness="1" CornerRadius="18" MinHeight="300" Padding="32">
                <StackPanel Spacing="13" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                  <Border Width="55" Height="55" CornerRadius="17" Background="{DynamicResource RaisedSurface}" HorizontalAlignment="Left">
                    <Viewbox Width="24" Height="24"><Path Data="{StaticResource MusicIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" /></Viewbox>
                  </Border>
                  <TextBlock Text="{Binding FeatureTitle}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FeatureDescription}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FeatureFootnote}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" Margin="0,8,0,0" />
                  <Button Classes="secondary" Content="Back to Home  →" Command="{Binding NavigateCommand}" CommandParameter="home"
                          HorizontalAlignment="Left" AutomationProperties.Name="Back to Home" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Five actual themes; selecting one changes the shared UI immediately. -->
            <StackPanel IsVisible="{Binding IsSettings}" Spacing="20" MaxWidth="1050" HorizontalAlignment="Stretch">
              <StackPanel Spacing="5">
                <TextBlock Text="MAKE IT YOURS" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Appearance" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Choose a look that feels like you." Classes="muted" FontSize="13" />
              </StackPanel>
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
                      BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="6">
                  <TextBlock Text="Your theme" FontSize="16" FontWeight="Bold" />
                  <TextBlock Text="Five moods. One place for your music." Classes="muted" FontSize="12" />
                  <TextBlock Text="{Binding ThemeStatus}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <WrapPanel>
                <Button Classes="theme-card" Classes.selected="{Binding IsFrosted}" Width="174" Height="156"
                        Command="{Binding SelectThemeCommand}" CommandParameter="frosted" AutomationProperties.Name="Frosted Glass theme">
                  <StackPanel Spacing="8">
                    <Border Height="67" CornerRadius="8" Background="#15151F" BorderBrush="#343449" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="23" Height="23" Fill="#9B80FF" /><Ellipse Width="23" Height="23" Fill="#4DD0FF" /><Ellipse Width="23" Height="23" Fill="#F4F4F8" />
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Frosted Glass" FontSize="12" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsFrosted}" /></Grid>
                    <TextBlock Text="Dark · glass" Classes="subtle" FontSize="11" />
                  </StackPanel>
                </Button>
                <Button Classes="theme-card" Classes.selected="{Binding IsPaper}" Width="174" Height="156"
                        Command="{Binding SelectThemeCommand}" CommandParameter="paper-ink" AutomationProperties.Name="Paper and Ink theme">
                  <StackPanel Spacing="8">
                    <Border Height="67" CornerRadius="8" Background="#F4EFE4" BorderBrush="#D6CDBE" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="23" Height="23" Fill="#B3441F" /><Ellipse Width="23" Height="23" Fill="#2F5D50" /><Ellipse Width="23" Height="23" Fill="#211C14" />
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Paper &amp; Ink" FontSize="12" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsPaper}" /></Grid>
                    <TextBlock Text="Light · typographic" Classes="subtle" FontSize="11" />
                  </StackPanel>
                </Button>
                <Button Classes="theme-card" Classes.selected="{Binding IsNeon}" Width="174" Height="156"
                        Command="{Binding SelectThemeCommand}" CommandParameter="neon" AutomationProperties.Name="Neon Cyber theme">
                  <StackPanel Spacing="8">
                    <Border Height="67" CornerRadius="8" Background="#070B12" BorderBrush="#1B4742" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="23" Height="23" Fill="#00DDB0" /><Ellipse Width="23" Height="23" Fill="#FF3EC8" /><Ellipse Width="23" Height="23" Fill="#E8FEFF" />
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Neon Cyber" FontSize="12" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsNeon}" /></Grid>
                    <TextBlock Text="Dark · electric" Classes="subtle" FontSize="11" />
                  </StackPanel>
                </Button>
                <Button Classes="theme-card" Classes.selected="{Binding IsAurora}" Width="174" Height="156"
                        Command="{Binding SelectThemeCommand}" CommandParameter="aurora" AutomationProperties.Name="Aurora theme">
                  <StackPanel Spacing="8">
                    <Border Height="67" CornerRadius="8" Background="#101A36" BorderBrush="#2B3E68" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="23" Height="23" Fill="#6EE7FF" /><Ellipse Width="23" Height="23" Fill="#B490FF" /><Ellipse Width="23" Height="23" Fill="#EEF2FF" />
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Aurora" FontSize="12" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsAurora}" /></Grid>
                    <TextBlock Text="Dark · atmospheric" Classes="subtle" FontSize="11" />
                  </StackPanel>
                </Button>
                <Button Classes="theme-card" Classes.selected="{Binding IsVinyl}" Width="174" Height="156"
                        Command="{Binding SelectThemeCommand}" CommandParameter="vinyl" AutomationProperties.Name="Vinyl theme">
                  <StackPanel Spacing="8">
                    <Border Height="67" CornerRadius="8" Background="#221A14" BorderBrush="#48392C" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="23" Height="23" Fill="#E8A33D" /><Ellipse Width="23" Height="23" Fill="#BD5959" /><Ellipse Width="23" Height="23" Fill="#F3E9DC" />
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Vinyl" FontSize="12" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsVinyl}" /></Grid>
                    <TextBlock Text="Warm · retro" Classes="subtle" FontSize="11" />
                  </StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock Text="Windows and browser preview settings are separate. No account or sync is needed."
                         Classes="subtle" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

    </Grid>
  </Grid>
</UserControl>
