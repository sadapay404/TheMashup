<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon.

  Background is the app's own ground colour (mashup_void, the same value as the web theme), so the
  launcher mask and the splash screen agree and there is no colour jump between tapping the icon
  and the first frame.
  The foreground is the real artwork, supplied per density as PNG because it is a soft-glowing
  raster mark; the vector that used to live here was a placeholder that had nothing to do with the
  logo.
  Monochrome reuses the same layer: the system tints it, and the mark stays legible as a silhouette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/mashup_void" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
