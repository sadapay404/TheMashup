<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off everywhere. Every endpoint we talk to is HTTPS:
  music.youtube.com, *.googlevideo.com, lrclib.net, public API instances.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
