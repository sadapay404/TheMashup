{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheMashup",
  "version": "0.1.0",
  "identifier": "local.themashup.player",
  "build": {
    "beforeDevCommand": "pnpm --filter @themashup/web dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "pnpm --filter @themashup/web build",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TheMashup",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http://127.0.0.1:4000 http://localhost:4000; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4000 http://localhost:4000 ws://localhost:8080; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
